        "custom/updates": {
            "format": "{icon}{text}",
            "return-type": "json",
            "justify": "center",
            //"rotate": 270,
            "format-icons": {
                "has-updates": "󱍷\n",
                "updated": ""
            },
            "exec-if": "command -v waybar-module-pacman-updates",
            "exec": "waybar-module-pacman-updates --no-zero-output --color-semver-updates ",
            // "on-click": "uxterm -bg black -fg white -title app_float -e 'zsh -c \"~/.config/polybar/Updates --update-system; print -n \\\"Press enter to exit...\\\";read;\"'",
            "on-click": "footclient --title 'app_float' -o colors-dark.background=000000 -o colors-dark.foreground=00ff00  zsh -c '~/.config/polybar/Updates --update-system; read -k1 \"?Press enter to exit...\"'",
            // "on-click": "uxterm -bg black -fg white -title app_float -e 'zsh -c \"~/.config/polybar/Updates --update-system; print -n \\\"Press enter to exit...\\\";read;\"'",
            "on-click-right": "footclient --title 'app_float' zsh -c '~/.config/polybar/Updates --print-updates; read -k1 \"?Press enter to exit...\"'"
        }
    },
    {
        "name": "dock-mode",
        "layer": "top",
        "position": "bottom",
        "margin-right": -27,
        "margin-left": 0,
        "reload_style_on_change": true,
        "cffi/niri-taskbar": {
          "module_path": "/usr/lib/waybar/modules/libniri_taskbar-focused.so",
          "icon-size": 25,
          "active-first": false,
          "tooltip-format": "{title}"
        },
        "modules-left": ["niri/window"],
        "modules-center": ["custom/window_stats"],
        "modules-right": ["cffi/niri-taskbar"],
        "pulseaudio": {
            "scroll-step": 5,
            "format": " {icon} {volume}% ",
            "justify": "center",
            "format-bluetooth": " {volume}%",
            "format-bluetooth-muted": " ",
            "format-muted": "",
            "format-source": "{volume}% ",
            "format-source-muted": "",
            "format-icons": {
                "headphone": "",
                "hands-free": "",
                "headset": "",
                "phone": "",
                "portable": "",
                "car": "",
                "default": ["", "", ""]
            },
            "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
            "on-click-right": "pavucontrol"
        },
        "niri/window": {
            "format": "{}",
            "icon": true,
            "icon-size": 24,
            "separate-outputs": true
        },
        "niri/workspaces": {
            "justify": "center",
            "all-outputs": false,
            "format": "{index}",
            "hide-empty": true,
            "current-only": true
        },
        "custom/window_stats": {
            "exec": "~/.config/waybar/scripts/active_win_stats.sh",
            "interval": 1,
            "format": "{}",
            "tooltip": false,
            "all-outputs": false,
            "return-type": "json",
            "on-click": "btop"
        }
    }
